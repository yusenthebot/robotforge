<mujoco model="robotforge demo">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.3 0.3 0.3"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.32 0.35 0.39" rgb2="0.28 0.31 0.35"/>
    <material name="floor" texture="grid" texrepeat="8 8" rgba="0.3 0.33 0.37 1"/>
    <material name="body" rgba="0.9 0.92 0.95 1"/>
    <material name="joint" rgba="0.2 0.22 0.25 1"/>
    <material name="accent" rgba="0.35 0.66 1.0 1"/>
  </asset>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <position kp="40" kv="2" ctrlrange="-2.6 2.6" forcerange="-15 15"/>
    <geom friction="0.9 0.01 0.001"/>
  </default>

  <worldbody>
    <light pos="0.5 -0.5 2" dir="-0.2 0.2 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>

    <body name="base" pos="0 0 0">
      <geom name="pedestal" type="cylinder" size="0.07 0.04" pos="0 0 0.04" material="joint"/>
      <body name="turntable" pos="0 0 0.08">
        <joint name="yaw" type="hinge" axis="0 0 1"/>
        <geom name="turntable" type="cylinder" size="0.06 0.02" pos="0 0 0.02" material="body"/>
        <body name="upper_arm" pos="0 0 0.05">
          <joint name="shoulder" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
          <geom name="shoulder" type="cylinder" size="0.035 0.04" euler="1.5708 0 0" material="joint"/>
          <geom name="upper_arm" type="capsule" fromto="0 0 0 0 0 0.22" size="0.025" material="body"/>
          <body name="forearm" pos="0 0 0.22">
            <joint name="elbow" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
            <geom name="elbow" type="cylinder" size="0.03 0.035" euler="1.5708 0 0" material="joint"/>
            <geom name="forearm" type="capsule" fromto="0 0 0 0 0 0.18" size="0.02" material="body"/>
            <geom name="tip" type="sphere" pos="0 0 0.2" size="0.03" material="accent"/>
          </body>
        </body>
      </body>
    </body>

    <body name="red_cube" pos="0.32 0.05 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0.92 0.3 0.28 1" mass="0.08"/>
    </body>
    <body name="green_cube" pos="0.28 -0.18 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0.3 0.8 0.45 1" mass="0.08"/>
    </body>
    <body name="ball" pos="-0.25 0.2 0.05">
      <freejoint/>
      <geom type="sphere" size="0.05" rgba="0.98 0.75 0.25 1" mass="0.1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="yaw" joint="yaw"/>
    <position name="shoulder" joint="shoulder" ctrlrange="-1.6 1.6"/>
    <position name="elbow" joint="elbow" ctrlrange="-2.4 2.4"/>
  </actuator>
</mujoco>
